# Release signing credentials — TEMPLATE.
#
# Copy to android/keystore.properties (gitignored) and fill in. Per-machine,
# exactly like android/local.properties and Xcode signing. The real file and
# the .jks itself are gitignored; only this example is committed.
#
# Alternatively set these as environment variables, which take precedence:
#   RITUAL_KEYSTORE_FILE, RITUAL_KEYSTORE_PASSWORD,
#   RITUAL_KEYSTORE_ALIAS, RITUAL_KEYSTORE_ALIAS_PASSWORD
#
# storeFile is resolved relative to android/app/ when relative — use the
# ABSOLUTE path outside the repo so the key can never be swept into a commit
# by `git add -A`.

storeFile=/Users/christellebekker/.ritual-android-signing/ritual-upload-key.jks
storePassword=CHANGE_ME
keyAlias=ritual-upload
keyPassword=CHANGE_ME
