{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:uid",
      "has": [{ "type": "host", "value": "t.ritualhabits.com.au" }],
      "destination": "https://ritual-v2-mu.vercel.app/t/:uid",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron-streaks",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/daily-report.js": { "maxDuration": 60 },
    "api/telegram-webhook.js": { "maxDuration": 30 },
    "api/social-report.js": { "maxDuration": 60 },
    "api/debbie-webhook.js": { "maxDuration": 60 }
  }
}
